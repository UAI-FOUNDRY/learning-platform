# Root Environment Configuration
ENVIRONMENT=development
PORT=8000
FRONTEND_PORT=5173

# PostgreSQL / Supabase Database Connection
# Connection string will be provided once Supabase is created by the database teammate:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/learning_platform

# Authentication & Security
SECRET_KEY=replace_with_a_secure_random_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# Browsers allowed to call the API (comma separated; never * in production)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Used to build the links inside emails
FRONTEND_URL=http://localhost:5173

# Email: console (prints to the server log) | smtp | memory
EMAIL_BACKEND=console
EMAIL_FROM=Learning Platform <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
