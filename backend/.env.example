ENVIRONMENT=development
PORT=8000

# PostgreSQL / Supabase Database Connection
# Direct / Session pooler connection (port 5432):
# DATABASE_URL=postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:5432/postgres
# Transaction pooler connection (port 6543):
# DATABASE_URL=postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Local / Development PostgreSQL default:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/learning_platform

# Database Connection Pool Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# Authentication & Security
SECRET_KEY=replace_with_a_secure_random_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# Browsers allowed to call the API (comma separated; never * in production)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Used to build the links inside emails
FRONTEND_URL=http://localhost:5173

# Email: console (prints to the server log) | smtp | memory
EMAIL_BACKEND=console
EMAIL_FROM=Learning Platform <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# File storage: local (development, saves into UPLOAD_DIR) | supabase (production) | memory (tests)
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
API_PUBLIC_URL=http://localhost:8000
# Supabase Storage (Project Settings -> API). Keep the service role key secret: backend only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_PUBLIC_BUCKET=public-assets
STORAGE_PRIVATE_BUCKET=course-files
STORAGE_SIGNED_URL_TTL_SECONDS=3600
MAX_UPLOAD_MB=25
# Outgoing email: use SMTP_USE_SSL=true with port 465, or SMTP_USE_TLS=true with port 587
SMTP_USE_SSL=false

# Coding workspace: disabled (default) | judge0 | local (development only, not a sandbox)
CODE_RUNNER=disabled
JUDGE0_URL=
JUDGE0_AUTH_TOKEN=
JUDGE0_AUTH_HEADER=X-Auth-Token

# AI tutor: disabled (default) | anthropic
AI_PROVIDER=disabled
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
